{
	"name": "@7tocr/2pi",
	"version": "0.0.4",
	"description": "2pi: a research-writing agent built on pi — research material to paper draft, paper to Chinese invention patent application draft",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/7toCR/2pi.git"
	},
	"homepage": "https://github.com/7toCR/2pi#readme",
	"bugs": "https://github.com/7toCR/2pi/issues",
	"files": [
		"bin/*.mjs",
		"dist/**/*.js",
		"python/*.py",
		"python/requirements.txt",
		"skills/**/SKILL.md",
		"skills/**/LICENSE",
		"skills/**/references/*.md",
		"skills/**/scripts/*.py",
		"skills/**/assets/*",
		"skills/**/agents/*.yaml",
		"skills/SOURCES.json",
		"templates/**/*",
		"DESIGN.md",
		"ROADMAP.md"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"bin": {
		"2pi": "bin/2pi.mjs"
	},
	"scripts": {
		"start": "node bin/2pi.mjs",
		"check": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
		"prepack": "npm run check && npm run build && node scripts/check-package.mjs",
		"test:package": "node scripts/test-package.mjs",
		"sync-skills": "node scripts/sync-skills.mjs",
		"test": "node --test test/*.test.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.1.0",
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-codemode": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-mcp": "1.1.0",
		"@earendil-works/pi-telemetry": "1.1.0",
		"@earendil-works/pi-tui": "1.1.0",
		"diff": "8.0.4",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT"
}
